# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# keystores de assinatura Android — nunca commitar. O CI já decodifica o
# keystore a partir de um GitHub Secret (ver .github/workflows/build-android.yml)
*.jks
*.jks.b64
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
